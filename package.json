{
  "name": "urlaubsplaner",
  "version": "1.0.0",
  "private": true,
  "description": "Urlaubsplaner: Urlaub, EZA und Gleittage optimal um Feiertage legen, mit Szenarien und PDF-Export.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
